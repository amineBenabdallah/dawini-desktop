{
  "name": "dawini-desktop",
  "version": "1.0.2",
  "description": "Dawini — Desktop medical practice management for Algerian physicians",
  "author": "amineBenabdallah",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "npm run build:all && electron .",
    "dev": "concurrently \"npm run build:server -- --watch\" \"npm run build:electron -- --watch\" \"wait-on dist/electron/main.js && electron .\"",
    "build:all": "npm run build:shared && npm run build:server && npm run build:app && npm run build:electron",
    "build:shared": "tsc -p shared/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:app": "cd app && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "test:cov": "jest --coverage --config jest.config.js",
    "lint": "eslint \"{electron,server,shared}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "pack": "electron-builder --dir",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "dist:all": "npm run build:all && electron-builder -mwl",
    "postinstall": "echo Deps installed"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^18.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "electron-updater": "^6.0.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.12.0",
    "node-llama-cpp": "^3.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-builder-squirrel-windows": "^26.8.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.0"
  }
}
