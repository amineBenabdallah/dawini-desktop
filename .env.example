# Dawini Desktop — Environment Variables
# Copy to .env and customize

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_64char_hex
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# License validation
LICENSE_HMAC_SECRET=change_me_to_long_hex

# Server
PORT=3333
NODE_ENV=production

# Database (SQLite — auto-created in app data directory)
# No configuration needed — path is determined by Electron
